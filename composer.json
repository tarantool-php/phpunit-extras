{
    "name": "tarantool/phpunit-extras",
    "description": "A collection of helpers for PHPUnit to ease testing Tarantool libraries.",
    "keywords": ["tarantool", "phpunit", "annotations", "assertions", "expectations", "extensions", "mocking"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Eugene Leonovich",
            "email": "gen.work@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "composer/package-versions-deprecated": "1.11.99.5",
        "composer/semver": "^3.3",
        "rybakit/phpunit-extras": "dev-feature/php82-phpunit10-attributes-migration",
        "symfony/expression-language": "^7.0",
        "tarantool/client": "^0.10"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "phpunit/phpunit": "^10.5",
        "vimeo/psalm": "^5.23|^6"
    },
    "autoload": {
        "psr-4": {
            "Tarantool\\PhpUnit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tarantool\\PhpUnit\\Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [{
        "name": "local",
        "type": "path",
        "url": "/Users/gen/dev/php/phpunit-extras"
    }]
}
